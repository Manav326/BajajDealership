# Local Docker Compose settings only. Do not reuse these defaults in production.
POSTGRES_DB=bajaj_dealership
POSTGRES_USER=bajaj_app
POSTGRES_PASSWORD=bajaj_local_only
POSTGRES_PORT=5432
API_PORT=8080
CUSTOMER_WEB_PORT=3000
STAFF_WEB_PORT=3001

# Optional: override the physical Android phone API address.
# BAJAJ_ANDROID_API_BASE_URL=http://192.168.31.47:8080/

# Optional Meta social account connection. Keep disabled until a Meta app is configured.
# Use a currently supported Graph API version and a 32-byte encryption key encoded as Base64.
# Configure the exact OAuth callback URI in the Meta app, matching SOCIAL_META_REDIRECT_URI.
SOCIAL_META_ENABLED=false
SOCIAL_META_APP_ID=
SOCIAL_META_APP_SECRET=
SOCIAL_META_GRAPH_API_VERSION=
SOCIAL_META_REDIRECT_URI=
# Staff SPA URL including the #/social-media-studio route; no user-supplied redirect targets.
SOCIAL_META_COMPLETION_URL=
# Example generation (do not commit the output): openssl rand -base64 32
SOCIAL_META_TOKEN_ENCRYPTION_KEY_BASE64=

# Direct publishing: public API origin and server-side secrets only.
SOCIAL_MEDIA_PUBLIC_BASE_URL=
SOCIAL_MEDIA_MEDIA_DIR=./var/social-media-assets
# Separate 32-byte Base64 HMAC key for temporary signed artwork URLs; never commit the value.
SOCIAL_MEDIA_ASSET_SIGNING_KEY_BASE64=
SOCIAL_MEDIA_PUBLISH_POLL_INTERVAL_MS=15000

# Optional WhatsApp Business Cloud API. Keep disabled until an approved WABA setup is ready.
SOCIAL_WHATSAPP_ENABLED=false
SOCIAL_WHATSAPP_PHONE_NUMBER_ID=
SOCIAL_WHATSAPP_BUSINESS_ACCOUNT_ID=
# Store the live token as a deployment secret; never commit or expose it to the browser.
SOCIAL_WHATSAPP_ACCESS_TOKEN=
SOCIAL_WHATSAPP_VERIFY_TOKEN=
# Active dealership.code assigned to this WhatsApp phone number in this initial deployment mode.
SOCIAL_WHATSAPP_DEALERSHIP_CODE=
