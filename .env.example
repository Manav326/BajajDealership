# Local Docker Compose settings only. Do not reuse these defaults in production.
POSTGRES_DB=bajaj_dealership
POSTGRES_USER=bajaj_app
POSTGRES_PASSWORD=bajaj_local_only
POSTGRES_PORT=5432
API_PORT=8080
CUSTOMER_WEB_PORT=3000
STAFF_WEB_PORT=3001

# General API settings. Local same-origin proxies normally mean no explicit CORS origins are needed.
APP_VERSION=local
DB_POOL_MAX=10
DB_POOL_MIN=2
NOTIFICATION_DISPATCH_INTERVAL_MS=15000
# Optional: comma-separated origins if a browser calls the API directly instead of using a web proxy.
APP_CORS_ALLOWED_ORIGINS=
APP_CORS_ALLOWED_ORIGIN_1=
APP_CORS_ALLOWED_ORIGIN_2=

# Reuse the public Google OAuth web client ID used by QuantaEdge.
# Also register the customer portal origin in this client's Authorized JavaScript origins.
GOOGLE_WEB_CLIENT_ID=

# GHCR image tag used by pull mode (the default is the latest successful main build).
BAJAJ_IMAGE_TAG=latest

# Optional: override the physical Android phone API address.
# BAJAJ_ANDROID_API_BASE_URL=http://192.168.31.47:8080/

# APP_BOOTSTRAP_TOKEN is intentionally omitted. The local startup scripts generate a one-time
# first-owner setup token when this variable is absent. Do not add an empty active assignment.

# Optional Meta social account connection. Keep disabled until a Meta app is configured.
# Use a currently supported Graph API version and a 32-byte encryption key encoded as Base64.
# Configure the exact OAuth callback URI in the Meta app, matching SOCIAL_META_REDIRECT_URI.
SOCIAL_META_ENABLED=false
SOCIAL_META_APP_ID=
SOCIAL_META_APP_SECRET=
SOCIAL_META_GRAPH_API_VERSION=
SOCIAL_META_REDIRECT_URI=
# Staff SPA URL including the #/social-media-studio route; no user-supplied redirect targets.
SOCIAL_META_COMPLETION_URL=
# Example generation (do not commit the output): openssl rand -base64 32
SOCIAL_META_TOKEN_ENCRYPTION_KEY_BASE64=

# Campaign media: database storage is the default and needs no external storage service.
SOCIAL_MEDIA_STORAGE_BACKEND=database
# Filesystem storage is intended for local development; hosted free web filesystems are ephemeral.
SOCIAL_MEDIA_MEDIA_DIR=./var/social-media-assets
# Direct publishing requires a public API origin and server-side secrets.
SOCIAL_MEDIA_PUBLIC_BASE_URL=
# Separate 32-byte Base64 HMAC key for temporary signed artwork URLs; never commit the value.
SOCIAL_MEDIA_ASSET_SIGNING_KEY_BASE64=

# These are the exact variable names read by the Meta publishing scheduler.
SOCIAL_META_PUBLISH_POLL_INTERVAL_MS=15000
SOCIAL_META_PUBLISH_DISPATCH_INTERVAL_MS=10000

# WhatsApp Business Cloud API. Messaging charges may apply; keep disabled until an approved WABA
# setup and an authorized test recipient are ready.
SOCIAL_WHATSAPP_ENABLED=false
SOCIAL_WHATSAPP_DISPATCH_INTERVAL_MS=15000
SOCIAL_WHATSAPP_PHONE_NUMBER_ID=
SOCIAL_WHATSAPP_BUSINESS_ACCOUNT_ID=
# Store the live token as a deployment secret; never commit or expose it to the browser.
SOCIAL_WHATSAPP_ACCESS_TOKEN=
SOCIAL_WHATSAPP_VERIFY_TOKEN=
# This deployment's single dealership.code. Authorized staff share the connection via RBAC permissions.
SOCIAL_WHATSAPP_DEALERSHIP_CODE=
