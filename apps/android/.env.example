# Local development default for a physical Android phone on the same Wi-Fi as the API host.
# This address must serve the BajajDealership API (not only the mPAY API).
EXPO_PUBLIC_API_BASE_URL=http://192.168.31.47:8080/

# For an Android Studio emulator instead, uncomment:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080/

# For production, set the deployed Bajaj API's HTTPS URL.
