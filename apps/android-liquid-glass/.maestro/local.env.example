# Copy this file to local.env. local.env is gitignored; do not commit customer passwords.
# The local physical-device API URL is set by scripts/test-android-maestro.ps1.
MAESTRO_DEALERSHIP_CODE=LUCKY-BAJAJ
MAESTRO_CUSTOMER_CODE=REPLACE_WITH_DEDICATED_LOCAL_TEST_CUSTOMER_CODE
MAESTRO_CUSTOMER_PASSWORD=REPLACE_WITH_DEDICATED_LOCAL_TEST_CUSTOMER_PASSWORD
MAESTRO_CUSTOMER_VEHICLE_NAME=REPLACE_WITH_LINKED_MOTORCYCLE_MODEL_NAME

# A sent rich notification to this test customer with a PNG/JPEG image and CTA to /appointments.
MAESTRO_NOTIFICATION_TITLE=Maestro rich notification
MAESTRO_NOTIFICATION_IMAGE_ALT=Maestro fixture image
MAESTRO_NOTIFICATION_CTA_LABEL=Open service appointments
MAESTRO_NOTIFICATION_DESTINATION_HEADING=Service visits

# A separate sent notification on page 1 for read -> unread -> dismiss.
MAESTRO_NOTIFICATION_ACTION_TITLE=Maestro notification actions

# An older sent notification at position 26-50 to verify page 2.
MAESTRO_NOTIFICATION_PAGE_TWO_TITLE=Maestro page two fixture

# A sent campaign containing a CTA with an unsupported internal route (for example /admin).
MAESTRO_NOTIFICATION_UNSAFE_TARGET_TITLE=Maestro unsafe target fixture
MAESTRO_UNSAFE_CTA_LABEL=Unsupported admin action
